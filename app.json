{
  "expo": {
    "name": "Roamio",
    "slug": "roamio",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "roamio",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "icon": "./assets/icon.png",

    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Roamio needs your location to share SOS alerts and nearby safety info."
      }
    },

    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0E1117"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#0E1117"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
